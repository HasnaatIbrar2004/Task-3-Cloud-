# --- JWT ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# --- Postgres (used by docker compose; docker-compose.yml builds DATABASE_URL from these) ---
# Keep the password URL-safe (letters/digits), it ends up inside a connection URL.
POSTGRES_USER=voting
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=voting_db

# Only for running WITHOUT Docker (poetry run python main.py). Ignored by docker compose.
# DATABASE_URL=sqlite:///./app.db

# --- Logging (written to logs/logs.log; minimum level INFO) ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- MFA ---
MFA_EXPIRATION_MINUTES=5
MFA_MAX_ATTEMPTS=5

# --- SMTP (Ethereal: https://ethereal.email -> "Create Ethereal Account") ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-username@ethereal.email
SMTP_PASSWORD=your-ethereal-password
MAIL_FROM=voting-system@example.com
